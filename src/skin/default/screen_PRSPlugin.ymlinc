screen:
  backgroundColor: "md_transparent"
  name: "%PLUGIN%"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Full.ymlinc"
        position: "center"
    - ePixmap:
        cornerRadius: "$radius_window_inner"
        pixmap: "~/../images/backdrop.jpg"
        position: "2,72"
        scale: "scale"
        size: "1908,927"
        zPosition: "-2"
    - xmlinc:
        file: "screenpart_PRSPluginBody.ymlinc"
        position: "($screen_width-$child_width)/2-4,146"
