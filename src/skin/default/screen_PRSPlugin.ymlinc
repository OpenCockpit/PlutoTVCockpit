screen:
  backgroundColor: "md_transparent"
  name: "%PLUGIN%"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - ePixmap:
        cornerRadius: "$radius_window_inner"
        pixmap: "~/../images/backdrop.jpg"
        position: "2,72"
        scale: "scale"
        size: "1908,927"
        zPosition: "-2"
    - xmlinc:
        file: "screenpart_PRSPluginBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
