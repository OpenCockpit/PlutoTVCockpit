screen:
  name: "PRSDownloadProgress"
  position: "60,60"
  size: "620,200"
  children:
    - eLabel:
        alphatest: "blend"
        backgroundColor: "md_surface"
        cornerRadius: "$radius_dialog"
        position: "0,0"
        size: "620,200"
        widgetBorderColor: "md_surface_container_high"
        widgetBorderWidth: "2"
        zPosition: "-1"
    - widget:
        font: "$md_body_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "action"
        noWrap: "1"
        position: "20,34"
        size: "580,43"
        transparent: "1"
        valign: "center"
    - widget:
        backgroundColor: "md_surface_container_highest"
        borderColor: "md_outline"
        borderWidth: "1"
        cornerRadius: "$radius_bar_thick"
        foregroundColor: "md_primary"
        name: "progress"
        position: "20,94"
        size: "580,14"
    - widget:
        font: "$md_body_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "status"
        noWrap: "1"
        position: "20,125"
        size: "580,43"
        transparent: "1"
        valign: "center"
