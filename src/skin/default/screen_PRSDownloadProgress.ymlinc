screen:
  name: "PRSDownloadProgress"
  backgroundColor: "md_transparent"
  position: "60,60"
  size: "620,200"
  children:
    - eLabel:
        alphatest: "blend"
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_dialog"
        position: "0,0"
        size: "620,200"
        widgetBorderColor: "md_on_surface_variant"
        widgetBorderWidth: "2"
        zPosition: "-1"
    - widget:
        borderWidth: "1"
        font: "$md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "action"
        noWrap: "1"
        position: "15,32"
        size: "590,35"
        transparent: "1"
        valign: "center"
    - widget:
        alphatest: "blend"
        backgroundColor: "md_surface_container_lowest"
        borderWidth: "0"
        name: "progress"
        pixmap: "~/../images/progress.png"
        position: "15,94"
        size: "590,12"
        zPosition: "2"
    - widget:
        borderColor: "md_surface_container_lowest"
        borderWidth: "1"
        font: "$md_body_small"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "status"
        noWrap: "1"
        position: "15,138"
        size: "590,35"
        transparent: "1"
        valign: "center"
