screen:
  backgroundColor: "transparent"
  name: "CockpitPlayer"
  position: "center,center"
  size: "1920,1080"
  children:
    - ePixmap:
        alphatest: "blend"
        pixmap: "~/../images/player_bg_gradient.png"
        position: "0,860"
        size: "1920,220"
        zPosition: "-1"
    - widget:
        font: "$FR_medium"
        halign: "right"
        position: "$screen_width/2,1010"
        render: "Label"
        size: "225,50"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Position,Negate"
    - widget:
        font: "$FR_big"
        halign: "center"
        position: "$screen_width/2-100,1010"
        render: "Label"
        size: "200,50"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCMovieInfo"
              text: "MovieDuration"
          - convert:
              type: "ClockToText"
              text: "InMinutes"
    - widget:
        font: "$FR_medium"
        halign: "left"
        position: "$screen_width/2-225,1010"
        render: "Label"
        size: "225,50"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Remaining"
    - widget:
        alphatest: "blend"
        name: "player_icon"
        position: "30,900"
        size: "60,60"
        zPosition: "2"
    - widget:
        font: "$FR_bigger"
        noWrap: "1"
        position: "105,900"
        render: "Label"
        size: "1650,60"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCEventName"
              text: "Name"
    - widget:
        font: "$FB_big"
        halign: "center"
        position: "1770,900"
        render: "Label"
        size: "120,60"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "EndTime,ShowNoSeconds"
    - eLabel:
        backgroundColor: "backgroundLight"
        position: "30,980"
        size: "1860,10"
        zPosition: "0"
    - widget:
        alphatest: "blend"
        foregroundColor: "yellow"
        position: "30,980"
        render: "Progress"
        size: "1860,10"
        source: "Service"
        transparent: "1"
        zPosition: "2"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        foregroundColor: "darkgrey"
        position: "30,980"
        render: "Progress"
        size: "1860,10"
        source: "Service"
        transparent: "1"
        zPosition: "3"
        children:
          - convert:
              type: "COCBeforeTSPosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        foregroundColor: "red"
        position: "30,980"
        render: "Progress"
        size: "1860,10"
        source: "Service"
        transparent: "1"
        zPosition: "1"
        children:
          - convert:
              type: "COCRecordPosition"
              text: "Position"
    - widget:
        source: "session.CurrentService"
        render: "Label"
        position: "30,1010"
        size: "300,45"
        zPosition: "2"
        foregroundColor: "foreground"
        font: "$FR_medium"
        transparent: "1"
        valign: "center"
        halign: "left"
        children:
          - convert:
              type: "COCExtraInfo"
              text: "ResolutionString"
    - widget:
        addon: "COCServiceInfoBar"
        alignment: "right"
        audioChannelsIconPath: "$imagepath"
        audioCodecIconPath: "$imagepath"
        autoresizeMode: "condensed"
        connection: "session"
        elements: "videoRes,audioChannels,audioCodec,videoCodec,gamma"
        pixmaps: "IS_HD:$imagepath/icon_hd.png,IS_4K:$imagepath/icon_4k.png,IS_SD:$imagepath/icon_sd.png,IS_HDR:$imagepath/icon_hdr.png,IS_HDR10:$imagepath/icon_hdr10.png,IS_HLG:$imagepath/icon_hlg.png,icon_a-law:$imagepath/icon_a-law.png,icon_aac:$imagepath/icon_aac.png,icon_aac-eld:$imagepath/icon_aac-eld.png,icon_aac-lc:$imagepath/icon_aac-lc.png,icon_aac-ld:$imagepath/icon_aac-ld.png,icon_alac:$imagepath/icon_alac.png,icon_amr:$imagepath/icon_amr.png,icon_amr-wb:$imagepath/icon_amr-wb.png,icon_ape:$imagepath/icon_ape.png,icon_dolby-ac4:$imagepath/icon_dolby-ac4.png,icon_dolby-atmos:$imagepath/icon_dolby-atmos.png,icon_dolby-digital:$imagepath/icon_dolby-digital.png,icon_dolby-digital-plus:$imagepath/icon_dolby-digital-plus.png,icon_dolby-truehd:$imagepath/icon_dolby-truehd.png,icon_dsd:$imagepath/icon_dsd.png,icon_dts:$imagepath/icon_dts.png,icon_dts-96-24:$imagepath/icon_dts-96-24.png,icon_dts-es:$imagepath/icon_dts-es.png,icon_dts-express:$imagepath/icon_dts-express.png,icon_dts-hd:$imagepath/icon_dts-hd.png,icon_dts-hd-hra:$imagepath/icon_dts-hd-hra.png,icon_dts-hd-ma:$imagepath/icon_dts-hd-ma.png,icon_dts-x:$imagepath/icon_dts-x.png,icon_dts-x-imax:$imagepath/icon_dts-x-imax.png,icon_dts-x-pro:$imagepath/icon_dts-x-pro.png,icon_flac:$imagepath/icon_flac.png,icon_he-aac:$imagepath/icon_he-aac.png,icon_he-aac-v2:$imagepath/icon_he-aac-v2.png,icon_lpcm:$imagepath/icon_lpcm.png,icon_mlp:$imagepath/icon_mlp.png,icon_mp2:$imagepath/icon_mp2.png,icon_mp3:$imagepath/icon_mp3.png,icon_mpeg-layer-i:$imagepath/icon_mpeg-layer-i.png,icon_mpeg1-layer-ii:$imagepath/icon_mpeg1-layer-ii.png,icon_mu-law:$imagepath/icon_mu-law.png,icon_opus:$imagepath/icon_opus.png,icon_pcm:$imagepath/icon_pcm.png,icon_realaudio:$imagepath/icon_realaudio.png,icon_realaudio-14-4:$imagepath/icon_realaudio-14-4.png,icon_realaudio-28-8:$imagepath/icon_realaudio-28-8.png,icon_speex:$imagepath/icon_speex.png,icon_tta:$imagepath/icon_tta.png,icon_vorbis:$imagepath/icon_vorbis.png,icon_wavpack:$imagepath/icon_wavpack.png,icon_wma:$imagepath/icon_wma.png,icon_wma-lossless:$imagepath/icon_wma-lossless.png,icon_wma-pro:$imagepath/icon_wma-pro.png,icon_xhe-aac:$imagepath/icon_xhe-aac.png,icon_avc:$imagepath/icon_avc.png,icon_avs:$imagepath/icon_avs.png,icon_avs2:$imagepath/icon_avs2.png,icon_divx:$imagepath/icon_divx.png,icon_h263:$imagepath/icon_h263.png,icon_hevc:$imagepath/icon_hevc.png,icon_mpeg1:$imagepath/icon_mpeg1.png,icon_mpeg2:$imagepath/icon_mpeg2.png,icon_mpeg4:$imagepath/icon_mpeg4.png,icon_spark:$imagepath/icon_spark.png,icon_vc1:$imagepath/icon_vc1.png,icon_vc1-sm:$imagepath/icon_vc1-sm.png,icon_vp6:$imagepath/icon_vp6.png,icon_vp8:$imagepath/icon_vp8.png,icon_vp9:$imagepath/icon_vp9.png,icon_xvid:$imagepath/icon_xvid.png,icon_1-0:$imagepath/icon_1-0.png,icon_2-0:$imagepath/icon_2-0.png,icon_5-1:$imagepath/icon_5-1.png,icon_7-1:$imagepath/icon_7-1.png"
        position: "1390,1010"
        size: "500,45"
        spacing: "7"
        transparent: "1"
        videoCodecIconPath: "$imagepath"
        zPosition: "110"
