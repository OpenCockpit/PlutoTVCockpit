convert:
  type: "COCTemplatedMultiContentEx"
  cell:
    vars:
      - "ih = 45"
    itemHeight: ih
    fonts:
      - "$md_body_large"
    fields:
      - icon:
          position: "6,0"
          size: "32,ih"
          flags: BT_SCALE|BT_KEEP_ASPECT_RATIO|BT_VALIGN_CENTER
          value: 1
      - text:
          position: "50,0"
          size: "e-87,ih"
          flags: RT_VALIGN_CENTER
          value: 2
