screen:
  name: "PlayerTemplate"
  children:
    - eLabel:
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_window"
        position: "0,2"
        size: "1839,184"
        zPosition: "-11"
    - eLabel:
        backgroundColor: "md_surface"
        cornerRadius: "$radius_window_inner"
        position: "332,4"
        size: "1505,180"
        zPosition: "-10"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "342,55"
        size: "1485,2"
        zPosition: "-9"
    - eLabel:
        backgroundColor: "md_surface_container_highest"
        position: "1592,70"
        size: "2,100"
        zPosition: "-9"
    - widget:
        alphatest: "blend"
        name: "player_icon"
        position: "122,55"
        size: "90,90"
        zPosition: "3"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_medium"
        noWrap: "1"
        position: "362,75"
        render: "Label"
        size: "1120,50"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCEventName"
              text: "Name"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "667,4"
        render: "Label"
        size: "180,51"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Position"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        halign: "center"
        position: "857,4"
        render: "Label"
        size: "180,51"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Length"
    - widget:
        backgroundColor: "md_surface"
        font: "md_headline_small_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1047,4"
        render: "Label"
        size: "180,51"
        source: "Service"
        transparent: "1"
        valign: "center"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Remaining,Negate"
    - eLabel:
        backgroundColor: "md_surface_container"
        position: "362,150"
        size: "1170,4"
        transparent: "0"
        zPosition: "1"
    - widget:
        alphatest: "blend"
        cornerRadius: "$radius_bar_thick"
        foregroundColor: "md_error"
        position: "362,145"
        render: "Progress"
        size: "1170,12"
        source: "Service"
        transparent: "1"
        zPosition: "2"
        children:
          - convert:
              type: "COCRecordPosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        cornerRadius: "$radius_bar_thick"
        foregroundColor: "md_primary"
        position: "362,145"
        render: "Progress"
        size: "1170,12"
        source: "Service"
        transparent: "1"
        zPosition: "3"
        children:
          - convert:
              type: "COCServicePosition"
              text: "Position"
    - widget:
        alphatest: "blend"
        cornerRadius: "$radius_bar_thick"
        foregroundColor: "md_outline"
        position: "362,145"
        render: "Progress"
        size: "1170,12"
        source: "Service"
        transparent: "1"
        zPosition: "4"
        children:
          - convert:
              type: "COCBeforeTSPosition"
              text: "Position"
    - widget:
        backgroundColor: "md_surface"
        font: "md_display_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1552,65"
        render: "Label"
        size: "320,60"
        source: "Service"
        transparent: "1"
        valign: "top"
        zPosition: "20"
        children:
          - convert:
              type: "COCServicePosition"
              text: "EndTime,ShowNoSeconds"
    - widget:
        backgroundColor: "md_surface"
        font: "md_title_medium_emphasized"
        foregroundColor: "md_on_surface"
        halign: "center"
        position: "1552,130"
        render: "Label"
        size: "320,35"
        source: "global.CurrentTime"
        transparent: "1"
        valign: "top"
        zPosition: "20"
        children:
          - convert:
              type: "ClockToText"
              text: "Format: %d %B"
    - widget:
        alphatest: "blend"
        path: "icons/audioicon"
        position: "1567,0"
        render: "AudioIcon"
        size: "85,50"
        source: "session.CurrentService"
        zPosition: "10"
        children:
          - convert:
              type: "VAudioInfo"
              text: "AudioIcon"
    - widget:
        alphatest: "blend"
        pixmap: "icons/videoicon/mpeg2.png"
        position: "1662,9"
        render: "Pixmap"
        size: "80,40"
        source: "session.CurrentService"
        zPosition: "2"
        children:
          - convert:
              type: "ServiceInfo"
              text: "IsVideoMPEG2"
          - convert:
              type: "ConditionalShowHide"
    - widget:
        alphatest: "blend"
