# The list fills the left of the body, from the top edge to the bottom edge, with its pager at the bottom. The poster, the title and the
# description (screenpart_PRSPluginInfo) sit at the right end of the body: they are one block 1685 px wide, placed at $width-1685.
# The list ends 45 px (the gap between the poster and the description) before the poster.
- eLabel:
    backgroundColor: "md_surface"
    cornerRadius: "$radius_panel_large"
    position: "0,0"
    size: "$width-1122,$height"
    zPosition: "1"
- widget:
    backgroundColorSelected: "$backgroundColorSelected"
    enableWrapAround: "1"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showNever"
    size: "$width-1122,eval(($height-30)/$list_item_height*$list_item_height)"
    source: "feedlist"
    transparent: "1"
    zPosition: "5"
    children:
      - xmlinc:
          file: "screenpart_PRSList.ymlinc"
- widget:
    addon: "COCPager"
    backgroundColor: "md_surface"
    conditional: "feedlist"
    connection: "feedlist"
    position: "0,$height-25"
    size: "$width-1122,25"
    transparent: "1"
    zPosition: "5"
- widget:
    alphatest: "blend"
    font: "$md_body_large"
    halign: "right"
    position: "$width-1000,830"
    render: "Label"
    size: "1000,50"
    source: "updated"
    transparent: "1"
    valign: "center"
    zPosition: "5"
- widget:
    backgroundColor: "md_surface_container_lowest"
    font: "$md_title_large"
    halign: "center"
    name: "loading"
    position: "eval(($width-1685)/2+442),390"
    size: "800,60"
    transparent: "0"
    valign: "center"
    zPosition: "10"
- widget:
    font: "$md_title_large"
    foregroundColor: "md_warning"
    backgroundColor: "md_surface_container_lowest"
    cornerRadius: "$radius_panel_large"
    position: "$width-1075,50"
    render: "Label"
    valign: "top"
    size: "1075,48"
    source: "vtitle"
    zPosition: "5"
    children:
      - convert:
          type: "ConditionalShowHide"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface_container_lowest"
    cornerRadius: "$radius_poster_large_frame"
    font: "Regular;0"
    foregroundColor: "md_surface"
    name: "posterBG"
    position: "$width-1077,113"
    size: "472,679"
    widgetBorderColor: "md_key_yellow"
    widgetBorderWidth: "2"
    zPosition: "3"
- widget:
    alphatest: "blend"
    cornerRadius: "$radius_poster_large"
    scaleFlags: "scaleCenter"
    name: "poster"
    position: "$width-1075,115"
    size: "468,675"
    transparent: "1"
    zPosition: "5"
- xmlinc:
    file: "screenpart_PRSPluginInfo.ymlinc"
    position: "$width-1685,50"
