- eLabel:
    backgroundColor: "md_surface"
    cornerRadius: "$radius_panel_large"
    position: "eval(($width-1685)/2),50"
    size: "560,740"
    zPosition: "1"
- widget:
    backgroundColorSelected: "$backgroundColorSelected"
    enableWrapAround: "1"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "eval(($width-1685)/2),50"
    render: "Listbox"
    scrollbarMode: "showOnDemand"
    size: "560,720"
    source: "feedlist"
    transparent: "1"
    zPosition: "5"
    children:
      - xmlinc:
          file: "screenpart_PRSList.ymlinc"
- widget:
    alphatest: "blend"
    font: "$md_body_large"
    position: "eval(($width-1685)/2),830"
    render: "Label"
    size: "1000,50"
    source: "updated"
    transparent: "1"
    valign: "center"
    zPosition: "5"
- widget:
    backgroundColor: "md_surface_container_lowest"
    font: "$md_title_large"
    halign: "center"
    name: "loading"
    position: "eval(($width-1685)/2+442),390"
    size: "800,60"
    transparent: "0"
    valign: "center"
    zPosition: "10"
- widget:
    font: "$md_title_large"
    foregroundColor: "md_warning"
    backgroundColor: "md_surface_container_lowest"
    cornerRadius: "$radius_panel_large"
    position: "eval(($width-1685)/2+610),50"
    render: "Label"
    valign: "top"
    size: "1075,48"
    source: "vtitle"
    zPosition: "5"
    children:
      - convert:
          type: "ConditionalShowHide"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface_container_lowest"
    cornerRadius: "$radius_poster_large_frame"
    font: "Regular;0"
    foregroundColor: "md_surface"
    name: "posterBG"
    position: "eval(($width-1685)/2+608),113"
    size: "472,679"
    widgetBorderColor: "md_key_yellow"
    widgetBorderWidth: "2"
    zPosition: "3"
- widget:
    alphatest: "blend"
    cornerRadius: "$radius_poster_large"
    scaleFlags: "scaleCenter"
    name: "poster"
    position: "eval(($width-1685)/2+610),115"
    size: "468,675"
    transparent: "1"
    zPosition: "5"
- xmlinc:
    file: "screenpart_PRSPluginInfo.ymlinc"
    position: "eval(($width-1685)/2),50"
