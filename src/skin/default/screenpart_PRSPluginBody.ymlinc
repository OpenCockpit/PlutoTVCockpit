- eLabel:
    backgroundColor: "md_surface"
    position: "0,0"
    size: "615,740"
    zPosition: "1"
- widget:
    backgroundColorSelected: "$backgroundColorSelected"
    enableWrapAround: "1"
    foregroundColorSelected: "$foregroundColorSelected"
    itemCornerRadiusSelected: "$radius_item"
    position: "0,0"
    render: "Listbox"
    scrollbarMode: "showOnDemand"
    size: "615,720"
    source: "feedlist"
    transparent: "1"
    zPosition: "5"
    children:
      - xmlinc:
          file: "screenpart_PRSList.ymlinc"
- widget:
    alphatest: "blend"
    font: "$md_body_large"
    position: "0,780"
    render: "Label"
    size: "1000,50"
    source: "updated"
    transparent: "1"
    valign: "center"
    zPosition: "5"
- widget:
    backgroundColor: "md_surface_container_lowest"
    font: "$F_medium"
    halign: "center"
    name: "loading"
    position: "center,center"
    size: "800,60"
    transparent: "0"
    valign: "center"
    zPosition: "10"
- widget:
    font: "$md_title_large"
    foregroundColor: "md_warning"
    backgroundColor: "md_surface_container_lowest"
    position: "665,0"
    render: "Label"
    valign: "top"
    size: "1132,48"
    source: "vtitle"
    zPosition: "5"
    children:
      - convert:
          type: "ConditionalShowHide"
- widget:
    alphatest: "blend"
    backgroundColor: "md_surface_container_lowest"
    cornerRadius: "27"
    font: "Regular;0"
    foregroundColor: "md_surface"
    name: "posterBG"
    position: "663,63"
    size: "472,679"
    widgetBorderColor: "md_key_yellow"
    widgetBorderWidth: "2"
    zPosition: "3"
- widget:
    alphatest: "blend"
    cornerRadius: "25"
    scaleFlags: "scaleCenter"
    name: "poster"
    position: "665,65"
    size: "468,675"
    transparent: "1"
    zPosition: "5"
- xmlinc:
    file: "screenpart_PRSPluginInfo.ymlinc"
